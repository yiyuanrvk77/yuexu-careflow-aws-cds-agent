{
  "name": "yuexu-agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgentCore Runtime for Yuexu appointment operations",
  "main": "main.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch main.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@opentelemetry/api": "~1.9.0",
    "@strands-agents/sdk": "~1.5.0",
    "bedrock-agentcore": "~0.3.0",
    "tsx": "~4.19.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "~22.0.0",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "bedrock-agentcore": {
      "@strands-agents/sdk": "$@strands-agents/sdk"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
